from std/enums import Result

extern "C" fn glyph_time_now() -> u64;
extern "C" fn glyph_time_monotonic_ns() -> u64;
extern "C" fn glyph_time_to_human_readable(ts: u64) -> str;
extern "C" fn glyph_time_sleep_ms(ms: u32) -> i32;
extern "C" fn glyph_time_sleep_us(us: u32) -> i32;

struct Error {
  message: String
}

struct Timestamp {
  value: u64

  fn as_u64(self: &Timestamp) -> u64 {
    ret self.value
  }

  fn to_human_readable(self: &Timestamp) -> Result<String, Error> {
    let raw = glyph_time_to_human_readable(self.value)
    if raw.len() == 0 {
      ret Err(Error { message: String::from_str("timestamp conversion failed") })
    }
    let s = String::from_str(raw)
    ret Ok(s)
  }
}

fn get_timestamp() -> Timestamp {
  ret Timestamp { value: glyph_time_now() }
}

fn sleep_ms(ms: u32) -> Result<(), Error> {
  let rc = glyph_time_sleep_ms(ms)
  if rc == 0 {
    ret Ok(())
  }
  ret Err(Error { message: String::from_str("sleep_ms failed") })
}

fn sleep_us(us: u32) -> Result<(), Error> {
  let rc = glyph_time_sleep_us(us)
  if rc == 0 {
    ret Ok(())
  }
  ret Err(Error { message: String::from_str("sleep_us failed") })
}

// Monotonic high-resolution clock: unaffected by wall-clock changes; only
// the difference between two readings is meaningful. This is the timing
// source for sequencer ticks, audio scheduling, and latency measurement.
struct Instant {
  nanos: u64

  fn as_nanos(self: &Instant) -> u64 {
    ret self.nanos
  }

  fn elapsed_ns(self: &Instant) -> u64 {
    let now = glyph_time_monotonic_ns()
    if now < self.nanos {
      ret 0
    }
    ret now - self.nanos
  }

  fn elapsed_us(self: &Instant) -> u64 {
    ret self.elapsed_ns() / 1000
  }

  fn elapsed_ms(self: &Instant) -> u64 {
    ret self.elapsed_ns() / 1000000
  }
}

fn now_monotonic() -> Instant {
  ret Instant { nanos: glyph_time_monotonic_ns() }
}
