// GLYPH-56: voice pool + synth engine. Pure DSP, single-threaded, offline
// testable — no threads, channels, or I/O in this module.
//
// Voice state lives in three caller-owned Vecs (SoA layout) passed by
// reference, because struct Vec fields cannot be pushed/indexed through
// (see docs/design/SEQUENCER_CORE.md §3 constraint #3 and the compiler
// notes below). VOICES = 16 voices, matching §1 of that doc.
//
//   vi: Vec<u32>, stride vi_stride() = 5 per voice:
//     [0] active   (0 idle, 1 in use)
//     [1] track
//     [2] pitch    (MIDI note number)
//     [3] stage    (0 idle, 1 attack, 2 decay, 3 sustain, 4 release)
//     [4] waveform (0 sine, 1 saw, 2 square, 3 triangle)
//
//   vf: Vec<f64>, stride vf_stride() = 9 per voice:
//     [0] velocity
//     [1] phase       (radians, kept in [0, tau))
//     [2] phase_inc    (radians/frame)
//     [3] level        (current envelope level, 0..1)
//     [4] gain
//     [5] attack_step  (level delta per frame while stage == attack)
//     [6] decay_step   (level delta per frame while stage == decay)
//     [7] release_step / release_frames — dual-purpose slot: from note-on
//         until release begins it holds release_frames (the note's release
//         length in frames, floored to >= 1); voices_note_off /
//         voices_choke convert it in place to release_step = level /
//         release_frames at the moment release starts. voices_render_block
//         only ever reads it as a step (stage == 4), never as a frame
//         count, so the two meanings never collide.
//     [8] sustain_level
//
//   vt: Vec<u64>, stride 1 per voice: [0] started_frame — the frame at
//   which the voice's current note began, used to find the oldest voice
//   to steal when all 16 are active.

from std/math import sin, pow, fabs, fmax, tau
from std/vec import Vec

fn voice_count() -> i32 { ret 16 }
fn vi_stride() -> i32 { ret 5 }
fn vf_stride() -> i32 { ret 9 }

// pitch is cast to f64 BEFORE the subtraction: pitch is unsigned and
// pitch - 69 underflows for the whole register below A4.
fn voice_freq(pitch: u32) -> f64 {
  let p: f64 = pitch as f64
  ret 440.0 * pow(2.0, (p - 69.0) / 12.0)
}

fn osc_value(waveform: u32, phase: f64) -> f64 {
  let x: f64 = phase / tau()
  if waveform == 0 {
    ret sin(phase)
  }
  if waveform == 1 {
    ret 2.0 * x - 1.0
  }
  if waveform == 2 {
    if x < 0.5 { ret 1.0 }
    ret -1.0
  }
  // waveform 3: triangle
  ret 1.0 - 4.0 * fabs(x - 0.5)
}

fn voices_init(vi: &mut Vec<u32>, vf: &mut Vec<f64>, vt: &mut Vec<u64>) -> i32 {
  let total_vi: i32 = voice_count() * vi_stride()
  let mut i: i32 = 0
  while i < total_vi {
    vi.push(0)
    i = i + 1
  }
  let total_vf: i32 = voice_count() * vf_stride()
  let mut j: i32 = 0
  while j < total_vf {
    vf.push(0.0)
    j = j + 1
  }
  let mut k: i32 = 0
  while k < voice_count() {
    vt.push(0)
    k = k + 1
  }
  ret 0
}

// Allocation: first idle voice; if none is idle, steal the active voice
// with the smallest started_frame (oldest note wins the steal).
fn voices_note_on(vi: &mut Vec<u32>, vf: &mut Vec<f64>, vt: &mut Vec<u64>, frame: u64, track: u32, pitch: u32, velocity: f64, waveform: u32, gain: f64, attack_ms: f64, decay_ms: f64, sustain: f64, release_ms: f64) -> i32 {
  let stride_i: i32 = vi_stride()
  let mut idx: i32 = 0
  let mut free_idx: i32 = -1
  let mut oldest_idx: i32 = -1
  let mut oldest_frame: u64 = 0
  let mut have_oldest: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    let active = vi[base]
    if active == 0 {
      if free_idx < 0 {
        free_idx = idx
      }
    } else {
      let vframe: u64 = vt[idx as usize]
      if have_oldest == 0 {
        oldest_idx = idx
        oldest_frame = vframe
        have_oldest = 1
      } else {
        if vframe < oldest_frame {
          oldest_idx = idx
          oldest_frame = vframe
        }
      }
    }
    idx = idx + 1
  }
  let mut chosen: i32 = free_idx
  if chosen < 0 {
    chosen = oldest_idx
  }

  let vibase: usize = (chosen * stride_i) as usize
  let vfbase: usize = (chosen * vf_stride()) as usize

  vi[vibase] = 1
  vi[vibase + 1] = track
  vi[vibase + 2] = pitch
  vi[vibase + 3] = 1
  vi[vibase + 4] = waveform

  let freq: f64 = voice_freq(pitch)
  let phase_inc: f64 = freq * tau() / 48000.0
  // 1-frame floor keeps attack/decay/release from dividing by zero on a
  // zero-length envelope segment.
  let attack_step: f64 = 1.0 / fmax(1.0, attack_ms * 48.0)
  let decay_step: f64 = (1.0 - sustain) / fmax(1.0, decay_ms * 48.0)
  let release_frames: f64 = fmax(1.0, release_ms * 48.0)

  vf[vfbase] = velocity
  vf[vfbase + 1] = 0.0
  vf[vfbase + 2] = phase_inc
  vf[vfbase + 3] = 0.0
  vf[vfbase + 4] = gain
  vf[vfbase + 5] = attack_step
  vf[vfbase + 6] = decay_step
  vf[vfbase + 7] = release_frames
  vf[vfbase + 8] = sustain

  vt[chosen as usize] = frame

  ret chosen
}

// Releases every active voice matching (track, pitch) whose stage hasn't
// already reached release; returns the count released.
fn voices_note_off(vi: &mut Vec<u32>, vf: &mut Vec<f64>, track: u32, pitch: u32) -> i32 {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    let active = vi[base]
    if active != 0 {
      let vtrack = vi[base + 1]
      let vpitch = vi[base + 2]
      let stage = vi[base + 3]
      if vtrack == track {
        if vpitch == pitch {
          if stage < 4 {
            let fbase: usize = (idx * stride_f) as usize
            let level: f64 = vf[fbase + 3]
            let release_frames: f64 = vf[fbase + 7]
            vf[fbase + 7] = level / release_frames
            vi[base + 3] = 4
            count = count + 1
          }
        }
      }
    }
    idx = idx + 1
  }
  ret count
}

// Forces every active voice into a fixed 5 ms (240-frame at 48 kHz)
// release, regardless of the note's own release setting.
fn voices_choke(vi: &mut Vec<u32>, vf: &mut Vec<f64>) -> i32 {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    let active = vi[base]
    if active != 0 {
      let fbase: usize = (idx * stride_f) as usize
      let level: f64 = vf[fbase + 3]
      vf[fbase + 7] = level / 240.0
      vi[base + 3] = 4
      count = count + 1
    }
    idx = idx + 1
  }
  ret count
}

// Releases every active voice using its own release time, as if each had
// received a note_off. Used when the active pattern is swapped out from
// under sounding notes: their note_off events belonged to the old note
// list and will never be scheduled again, so without this they would ring
// forever. The per-voice release ramp is what keeps the swap click-free
// (unlike voices_choke, which forces a uniform 5 ms stop).
fn voices_release_all(vi: &mut Vec<u32>, vf: &mut Vec<f64>) -> i32 {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    if vi[base] != 0 {
      let stage = vi[base + 3]
      if stage < 4 {
        let fbase: usize = (idx * stride_f) as usize
        let level: f64 = vf[fbase + 3]
        let release_frames: f64 = vf[fbase + 7]
        vf[fbase + 7] = level / release_frames
        vi[base + 3] = 4
        count = count + 1
      }
    }
    idx = idx + 1
  }
  ret count
}

// Hard-stops every voice with no release ramp. Used where rendering must
// end on an exact frame (RenderTo) or has already ended (shutdown), so the
// click a hard cut would cause is never rendered. Prefer voices_choke for
// a musical stop.
fn voices_silence_all(vi: &mut Vec<u32>, vf: &mut Vec<f64>) -> i32 {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    if vi[base] != 0 {
      count = count + 1
    }
    vi[base] = 0
    vi[base + 3] = 0
    let fbase: usize = (idx * stride_f) as usize
    vf[fbase + 3] = 0.0
    idx = idx + 1
  }
  ret count
}

// Retunes the gain of every voice already sounding on a track, so a live
// gain change is audible on held notes instead of only on the next one.
fn voices_set_track_gain(vi: &mut Vec<u32>, vf: &mut Vec<f64>, track: u32, gain: f64) -> i32 {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    if vi[base] != 0 {
      let vtrack = vi[base + 1]
      if vtrack == track {
        let fbase: usize = (idx * stride_f) as usize
        vf[fbase + 4] = gain
        count = count + 1
      }
    }
    idx = idx + 1
  }
  ret count
}

fn voices_active_count(vi: &Vec<u32>) -> i32 {
  let stride_i: i32 = vi_stride()
  let mut idx: i32 = 0
  let mut count: i32 = 0
  while idx < voice_count() {
    let base: usize = (idx * stride_i) as usize
    if vi[base] != 0 {
      count = count + 1
    }
    idx = idx + 1
  }
  ret count
}

// Renders block_frames of audio, mixing every active voice's
// oscillator * level * velocity * gain into one channel. No clamping —
// the WAV writer clamps on the way to 16-bit PCM.
fn voices_render_block(vi: &mut Vec<u32>, vf: &mut Vec<f64>, block_frames: u32) -> Vec<f64> {
  let stride_i: i32 = vi_stride()
  let stride_f: i32 = vf_stride()
  let mut out: Vec<f64> = Vec::new()
  let mut frame: u32 = 0
  while frame < block_frames {
    let mut sum: f64 = 0.0
    let mut idx: i32 = 0
    while idx < voice_count() {
      let base: usize = (idx * stride_i) as usize
      if vi[base] != 0 {
        let fbase: usize = (idx * stride_f) as usize
        let waveform = vi[base + 4]
        let phase: f64 = vf[fbase + 1]
        let level: f64 = vf[fbase + 3]
        let velocity: f64 = vf[fbase]
        let gain: f64 = vf[fbase + 4]
        let osc: f64 = osc_value(waveform, phase)
        sum = sum + osc * level * velocity * gain
      }
      idx = idx + 1
    }
    out.push(sum)

    // Envelope + phase advance happens AFTER the sample is taken, so the
    // very first frame of an attack renders at level == 0.
    let mut vidx: i32 = 0
    while vidx < voice_count() {
      let base: usize = (vidx * stride_i) as usize
      if vi[base] != 0 {
        let fbase: usize = (vidx * stride_f) as usize
        let stage = vi[base + 3]
        let mut level: f64 = vf[fbase + 3]
        if stage == 1 {
          let attack_step: f64 = vf[fbase + 5]
          level = level + attack_step
          if level >= 1.0 {
            level = 1.0
            vi[base + 3] = 2
          }
        } else {
          if stage == 2 {
            let decay_step: f64 = vf[fbase + 6]
            let sustain_level: f64 = vf[fbase + 8]
            level = level - decay_step
            if level <= sustain_level {
              level = sustain_level
              vi[base + 3] = 3
            }
          } else {
            if stage == 4 {
              let release_step: f64 = vf[fbase + 7]
              level = level - release_step
              if level <= 0.0 {
                level = 0.0
                vi[base] = 0
                vi[base + 3] = 0
              }
            }
          }
        }
        vf[fbase + 3] = level

        let mut phase: f64 = vf[fbase + 1]
        let phase_inc: f64 = vf[fbase + 2]
        phase = phase + phase_inc
        if phase >= tau() {
          phase = phase - tau()
        }
        vf[fbase + 1] = phase
      }
      vidx = vidx + 1
    }

    frame = frame + 1
  }
  ret out
}

fn block_peak(block: &Vec<f64>) -> f64 {
  let n: usize = block.len()
  let mut i: usize = 0
  let mut peak: f64 = 0.0
  while i < n {
    let v: f64 = fabs(block[i])
    if v > peak {
      peak = v
    }
    i = i + 1
  }
  ret peak
}
