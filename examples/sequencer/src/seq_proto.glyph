// GLYPH-57 -- the wire vocabulary shared by the control thread and the
// engine thread, plus the engine's fixed constants.
//
// This module is deliberately types-and-constants only: it is imported by
// both sides of the SPSC channels, so it must never pull in a sink, a voice
// pool, or anything thread-affine.
//
// Every struct here is FLAT and SCALAR-ONLY. That is not a style choice --
// SEQUENCER_CORE.md §3 constraint #1 records that flat scalar-struct enum
// payloads are the shape proven to cross both an SPSC channel and a spawn
// boundary, and constraint #2 records that Vec-carrying payloads are
// rejected by the thread-safety checker. A pattern therefore reaches the
// engine as a *stream* of these messages, never as one Pattern value.

// --- Constants (SEQUENCER_CORE.md §1) ---
// Glyph has no const items; these are the canonical accessors.

fn sample_rate() -> u32 { ret 48000 }
fn block_frames() -> u32 { ret 256 }
fn ppq() -> u32 { ret 960 }
// v1 is fixed 4/4, so one bar is 4 quarter notes.
fn bar_ticks() -> u32 { ret 3840 }
fn cmd_capacity() -> usize { ret 64 }
fn report_capacity() -> usize { ret 64 }
fn default_bpm() -> f64 { ret 120.0 }
// Highest track index the engine tracks gain for.
fn max_tracks() -> u32 { ret 16 }

// Sink discriminants. The sink crosses the spawn boundary as a scalar pair
// (kind, handle) rather than as the enum the ADR originally sketched --
// see the header comment of seq_engine.glyph for why.
fn sink_wav() -> u32 { ret 0 }
fn sink_live() -> u32 { ret 1 }

// --- Command payloads (SEQUENCER_CORE.md §4) ---

struct PatternHeader {
  length_ticks: u32,
  track_count: u32,
}

struct PatternNoteMsg {
  track: u32,
  tick: u32,
  length_ticks: u32,
  pitch: u32,
  velocity: f64,
}

// waveform is u32 (0 Sine, 1 Saw, 2 Square, 3 Triangle) rather than the
// control-side Waveform enum: enum-typed fields inside channel payload
// structs are unproven (SEQUENCER_CORE.md §11).
struct TrackParamsMsg {
  track: u32,
  waveform: u32,
  gain: f64,
  attack_ms: f64,
  decay_ms: f64,
  sustain: f64,
  release_ms: f64,
}

struct NoteCmd {
  track: u32,
  pitch: u32,
  velocity: f64,
}

struct GainCmd {
  track: u32,
  gain: f64,
}

enum EngineCommand {
  Play,
  Stop,
  Rewind,
  SetTempo(f64),
  RenderTo(u64),
  PatternBegin(PatternHeader),
  PatternNote(PatternNoteMsg),
  PatternTrack(TrackParamsMsg),
  PatternCommit,
  NoteOn(NoteCmd),
  NoteOff(NoteCmd),
  SetTrackGain(GainCmd),
  Shutdown,
}

// --- Report payloads (SEQUENCER_CORE.md §5) ---

// tick is the PATTERN-LOCAL position (playhead modulo the active pattern
// length), which is what a UI playhead wants; frame is absolute and never
// resets for the life of the engine.
struct PositionReport {
  frame: u64,
  tick: u32,
  playing: bool,
}

struct BlockReport {
  frame: u64,
  peak: f64,
}

enum EngineReport {
  Position(PositionReport),
  BlockRendered(BlockReport),
  Overflow(u32),
  Stopped(u64),
}

// --- Default instrument ---
// Used for a track that plays before any PatternTrack has described it
// (the MCP "just play me a note" path).

fn default_track_params(track: u32) -> TrackParamsMsg {
  ret TrackParamsMsg {
    track: track,
    waveform: 0,
    gain: 0.8,
    attack_ms: 5.0,
    decay_ms: 50.0,
    sustain: 0.7,
    release_ms: 80.0,
  }
}

// Musical time base: how far the playhead advances per rendered frame.
// One f64 multiply per block (never a running +=) is what keeps the
// playhead exact over long renders -- SEQUENCER_CORE.md §6.
fn ticks_per_frame(bpm: f64) -> f64 {
  ret bpm * ppq() as f64 / (60.0 * sample_rate() as f64)
}
