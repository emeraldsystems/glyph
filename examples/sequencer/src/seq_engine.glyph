// GLYPH-57 (engine thread, sink, command/report loop) and GLYPH-58
// (transport + tick scheduler). This module is everything that runs on the
// ENGINE thread; nothing here is called from the control thread except
// engine_run itself, which the spawned closure forwards to.
//
// ----------------------------------------------------------------------
// Two deviations from SEQUENCER_CORE.md, both forced by the compiler and
// both re-verified by probe during GLYPH-57. The ADR has been updated to
// match (§3 constraints #7/#8, §7).
//
// 1. THE SINK IS A SCALAR (kind, handle) PAIR, NOT AN ENUM.
//    The ADR sketched `Sink = enum { Wav(WavWriter), Live(AudioOut) }`
//    owned by the engine closure. That cannot work:
//      - `AudioOut` is deliberately NOT Send. The checker rejects the
//        capture with "live audio devices are engine-thread-affine", so a
//        live device can never be handed to the engine thread at all.
//      - `match` requires an enum *value*; matching through a `&mut Sink`
//        fails with "match scrutinee must be an enum value", so there is
//        no way to write through an enum-held writer without moving it out.
//    Instead the engine receives a flat `(sink_kind, wav_handle,
//    sample_rate, channels)` and owns the device itself: the WAV handle is
//    opened by CONTROL (which owns the path String -- a `str` capture is
//    also rejected, "borrowed capture cannot escape through a transfer
//    site"), while the LIVE device is opened here, on the engine thread,
//    where it is required to live. Both std/audio writers are transparent
//    `{ handle: i32 }` wrappers, so rebuilding one around the handle at
//    each write site is free and keeps the typed std/audio API in play.
//
// 2. THE ENGINE BODY IS A TOP-LEVEL FN, NOT A CLOSURE BODY.
//    `engine_run` takes ownership of both channel endpoints as ordinary
//    parameters (verified), so the spawned FnOnce is a one-line forward.
//    This keeps the loop readable and reviewable.
//
// One further compiler constraint shapes the code below: Glyph has no
// scalar `&mut` out-parameters and a `Sender<T>` can be passed neither by
// reference ("methods can only be called on struct types") nor usefully by
// value. Every report send is therefore written INLINE in engine_run
// rather than factored into a helper. The repetition is deliberate.
// ----------------------------------------------------------------------

from seq_proto import EngineCommand, EngineReport, PatternHeader, PatternNoteMsg, TrackParamsMsg, NoteCmd, GainCmd, PositionReport, BlockReport
from seq_proto import sample_rate, block_frames, ppq, bar_ticks, default_bpm, max_tracks, sink_wav, sink_live, default_track_params, ticks_per_frame
from seq_voice import voices_init, voices_note_on, voices_note_off, voices_choke, voices_release_all, voices_silence_all, voices_set_track_gain, voices_active_count, voices_render_block, block_peak
from std/audio import WavWriter, AudioOut, out_open
from std/enums import Result
from std/math import ceil, floor, fmod, round
from std/sync/spsc import Sender, Receiver, TrySendResult, TryRecvResult
from std/time import sleep_ms
from std/vec import Vec

// --- Sink -------------------------------------------------------------
// std/audio's writers are transparent handle wrappers, so the engine can
// carry the bare handle and rebuild the typed writer at each call.

fn wav_from_handle(h: i32) -> WavWriter { ret WavWriter { handle: h } }
fn out_from_handle(h: i32) -> AudioOut { ret AudioOut { handle: h } }

// Returns 0 on success. A live write BLOCKS until the device has queue
// space -- that blocking is what paces the whole engine loop off the audio
// clock. A WAV write returns immediately, so offline renders run at CPU
// speed with no sleep anywhere in the loop (ADR §7).
fn sink_write(kind: u32, handle: i32, block: &Vec<f64>) -> i32 {
  if kind == sink_wav() {
    let mut w = wav_from_handle(handle)
    ret match w.write(block) {
      Ok(_n) => 0,
      Err(_e) => 1,
    }
  }
  let mut a = out_from_handle(handle)
  ret match a.write(block) {
    Ok(_n) => 0,
    Err(_e) => 2,
  }
}

// WAV close patches the RIFF header, so a skipped close leaves a corrupt
// file; live close drains the device queue.
fn sink_close(kind: u32, handle: i32) -> i32 {
  if kind == sink_wav() {
    let mut w = wav_from_handle(handle)
    ret match w.close() {
      Ok(_u) => 0,
      Err(_e) => 3,
    }
  }
  let mut a = out_from_handle(handle)
  ret match a.close() {
    Ok(_u) => 0,
    Err(_e) => 4,
  }
}

// --- Pattern storage helpers -----------------------------------------
// Engine pattern storage is function-local Vecs (ADR §7 / §3 constraint
// #3): a flat note list carrying its own track field, plus per-track
// params. Vec has no clear(), so "empty it" is `x = Vec::new()`.

fn copy_notes(src: &Vec<PatternNoteMsg>, dst: &mut Vec<PatternNoteMsg>) -> i32 {
  let mut i: i32 = 0
  while i < src.len() as i32 {
    dst.push(src[i as usize])
    i = i + 1
  }
  ret 0
}

fn copy_tracks(src: &Vec<TrackParamsMsg>, dst: &mut Vec<TrackParamsMsg>) -> i32 {
  let mut i: i32 = 0
  while i < src.len() as i32 {
    dst.push(src[i as usize])
    i = i + 1
  }
  ret 0
}

// Insertion sort by tick at commit (ADR §7). Event collection does not
// depend on note order, but a tick-sorted list keeps the per-block event
// list nearly sorted, which is what the event sort below is tuned for.
fn sort_notes_by_tick(notes: &mut Vec<PatternNoteMsg>) -> i32 {
  let n: i32 = notes.len() as i32
  let mut i: i32 = 1
  while i < n {
    let key = notes[i as usize]
    let mut j: i32 = i - 1
    let mut placed: bool = false
    while j >= 0 && placed == false {
      let probe = notes[j as usize]
      if probe.tick > key.tick {
        notes[(j + 1) as usize] = probe
        j = j - 1
      } else {
        placed = true
      }
    }
    notes[(j + 1) as usize] = key
    i = i + 1
  }
  ret 0
}

// Params for a track, falling back to the default instrument so that a
// live NoteOn on an undescribed track still makes a sound (the MCP
// "just play me a note" path).
fn track_params_for(tracks: &Vec<TrackParamsMsg>, track: u32) -> TrackParamsMsg {
  let mut i: i32 = 0
  while i < tracks.len() as i32 {
    let t = tracks[i as usize]
    if t.track == track {
      ret t
    }
    i = i + 1
  }
  ret default_track_params(track)
}

// A SetTrackGain override (>= 0.0) wins over the pattern's track gain.
fn effective_gain(gain_ovr: &Vec<f64>, track: u32, base_gain: f64) -> f64 {
  if track < max_tracks() {
    let g: f64 = gain_ovr[track as usize]
    if g >= 0.0 {
      ret g
    }
  }
  ret base_gain
}

// --- Scheduler (GLYPH-58) --------------------------------------------

// One scheduled note edge inside the current block. Engine-local only, so
// unlike the wire structs this one may live in a Vec freely.
struct SchedEvent {
  frame_offset: u32,
  kind: u32,        // 0 = note off, 1 = note on
  track: u32,
  pitch: u32,
  velocity: f64,
}

// Collects every note edge whose musical tick falls in
// [block_start_tick, block_end_tick).
//
// The pattern loops forever, so a note at pattern tick t sounds at every
// absolute tick t + k*length. Rather than tracking a wrapped playhead and
// special-casing blocks that straddle the loop point, we solve directly
// for the occurrences k that land inside this block. A note whose release
// runs past the loop point therefore gets its note-off at the correct
// absolute tick in the *next* iteration, for free.
fn collect_events(notes: &Vec<PatternNoteMsg>, length_ticks: u32, block_start_tick: f64, block_end_tick: f64, tpf: f64, frames: u32, out: &mut Vec<SchedEvent>) -> i32 {
  if length_ticks == 0 {
    ret 0
  }
  let l: f64 = length_ticks as f64
  let last_frame: i32 = frames as i32 - 1
  let mut i: i32 = 0
  while i < notes.len() as i32 {
    let note = notes[i as usize]

    // note-on occurrences
    let on_base: f64 = note.tick as f64
    let mut k: f64 = 0.0
    if on_base < block_start_tick {
      k = ceil((block_start_tick - on_base) / l)
    }
    let mut t: f64 = on_base + k * l
    while t < block_end_tick {
      if t >= block_start_tick {
        let mut fo: i32 = round((t - block_start_tick) / tpf) as i32
        if fo < 0 { fo = 0 }
        if fo > last_frame { fo = last_frame }
        out.push(SchedEvent {
          frame_offset: fo as u32,
          kind: 1,
          track: note.track,
          pitch: note.pitch,
          velocity: note.velocity,
        })
      }
      k = k + 1.0
      t = on_base + k * l
    }

    // note-off occurrences: the same occurrence index k, offset by the
    // note's length, so a note that sustains across the loop point is
    // released at the right absolute tick.
    let off_base: f64 = (note.tick + note.length_ticks) as f64
    let mut k2: f64 = 0.0
    if off_base < block_start_tick {
      k2 = ceil((block_start_tick - off_base) / l)
    }
    let mut t2: f64 = off_base + k2 * l
    while t2 < block_end_tick {
      if t2 >= block_start_tick {
        let mut fo2: i32 = round((t2 - block_start_tick) / tpf) as i32
        if fo2 < 0 { fo2 = 0 }
        if fo2 > last_frame { fo2 = last_frame }
        out.push(SchedEvent {
          frame_offset: fo2 as u32,
          kind: 0,
          track: note.track,
          pitch: note.pitch,
          velocity: note.velocity,
        })
      }
      k2 = k2 + 1.0
      t2 = off_base + k2 * l
    }

    i = i + 1
  }
  ret 0
}

// Sort by frame, then note-offs before note-ons at the same frame so a
// repeated note releases its previous voice before retriggering.
fn sort_events(evs: &mut Vec<SchedEvent>) -> i32 {
  let n: i32 = evs.len() as i32
  let mut i: i32 = 1
  while i < n {
    let key = evs[i as usize]
    let mut j: i32 = i - 1
    let mut placed: bool = false
    while j >= 0 && placed == false {
      let probe = evs[j as usize]
      let after: bool = probe.frame_offset > key.frame_offset || (probe.frame_offset == key.frame_offset && probe.kind > key.kind)
      if after {
        evs[(j + 1) as usize] = probe
        j = j - 1
      } else {
        placed = true
      }
    }
    evs[(j + 1) as usize] = key
    i = i + 1
  }
  ret 0
}

fn append_samples(dst: &mut Vec<f64>, src: &Vec<f64>) -> i32 {
  let mut i: i32 = 0
  while i < src.len() as i32 {
    dst.push(src[i as usize])
    i = i + 1
  }
  ret 0
}

// The playhead is recomputed from the absolute frame counter every block
// (never accumulated), which bounds drift at ~1e-6 tick over an hour --
// ADR §6.
fn playhead_at(span_start_tick: f64, span_start_frame: u64, frame: u64, tpf: f64) -> f64 {
  ret span_start_tick + (frame - span_start_frame) as f64 * tpf
}

// Pattern-local playhead for the Position report.
fn local_tick(playhead: f64, length_ticks: u32) -> u32 {
  if length_ticks == 0 {
    ret playhead as u32
  }
  ret fmod(playhead, length_ticks as f64) as u32
}

// --- The engine thread ------------------------------------------------

// Owns both channel endpoints, the sink, the voice pool, and the musical
// clock for the life of the thread. Returns 0 on a clean shutdown, nonzero
// if the sink failed (all engine errors are terminal in v1, ADR §7).
//
// Exit codes: 0 ok · 90 live device open failed · 91 sink write failed
// · 92 sink close failed.
fn engine_run(rx: Receiver<EngineCommand>, tx: Sender<EngineReport>, sink_kind: u32, wav_handle: i32, rate: u32, channels: u32) -> i32 {
  let mut r = rx
  let t = tx

  // The WAV handle is opened by control (it owns the path); the live
  // device MUST be opened here because it is engine-thread-affine.
  let mut handle: i32 = wav_handle
  if sink_kind == sink_live() {
    let opened = out_open(rate, channels)
    handle = match opened {
      Ok(a) => a.handle,
      Err(_e) => { ret 90 },
    }
  }

  // Voice pool (GLYPH-56), owned here for the life of the thread.
  let mut vi: Vec<u32> = Vec::new()
  let mut vf: Vec<f64> = Vec::new()
  let mut vt: Vec<u64> = Vec::new()
  let _vinit = voices_init(&mut vi, &mut vf, &mut vt)

  // Per-track gain overrides; -1.0 means "no override".
  let mut gain_ovr: Vec<f64> = Vec::new()
  let mut gi: u32 = 0
  while gi < max_tracks() {
    gain_ovr.push(0.0 - 1.0)
    gi = gi + 1
  }

  // Transport state.
  let mut frame: u64 = 0
  let mut playing: bool = false
  let mut bpm: f64 = default_bpm()
  let mut span_start_tick: f64 = 0.0
  let mut span_start_frame: u64 = 0
  let mut paused_tick: f64 = 0.0
  let mut last_bar: f64 = 0.0 - 1.0

  // Three pattern buffers: staging (open Begin window), pending
  // (committed, awaiting its swap boundary), active (playing) -- ADR §4.
  let mut stg_notes: Vec<PatternNoteMsg> = Vec::new()
  let mut stg_tracks: Vec<TrackParamsMsg> = Vec::new()
  let mut stg_len: u32 = 0
  let mut pnd_notes: Vec<PatternNoteMsg> = Vec::new()
  let mut pnd_tracks: Vec<TrackParamsMsg> = Vec::new()
  let mut pnd_len: u32 = 0
  let mut pending_valid: bool = false
  let mut commit_while_stopped: bool = false
  let mut act_notes: Vec<PatternNoteMsg> = Vec::new()
  let mut act_tracks: Vec<TrackParamsMsg> = Vec::new()
  let mut act_len: u32 = 0

  // RenderTo bookkeeping (deterministic offline renders).
  let mut render_active: bool = false
  let mut render_target: u64 = 0

  // Report bookkeeping.
  let mut dropped: u32 = 0
  let mut pending_stopped: bool = false
  let mut stopped_frame: u64 = 0

  let mut running: bool = true
  let mut status: i32 = 0

  while running {
    // ---- drain every pending command (ADR §7) ----
    let mut draining: bool = true
    while draining {
      let got = r.try_recv()
      match got {
        Value(cmd) => match cmd {
          Play => {
            if playing == false {
              span_start_tick = paused_tick
              span_start_frame = frame
              playing = true
              last_bar = floor(paused_tick / bar_ticks() as f64)
            }
          },
          Stop => {
            if playing {
              paused_tick = playhead_at(span_start_tick, span_start_frame, frame, ticks_per_frame(bpm))
              playing = false
            }
            let _choked = voices_choke(&mut vi, &mut vf)
          },
          Rewind => {
            paused_tick = 0.0
            span_start_tick = 0.0
            span_start_frame = frame
            last_bar = 0.0
          },
          SetTempo(new_bpm) => {
            // Rebase the span so the musical position is continuous
            // across the tempo change, then let the new rate apply from
            // the next block.
            if playing {
              let here: f64 = playhead_at(span_start_tick, span_start_frame, frame, ticks_per_frame(bpm))
              span_start_tick = here
              span_start_frame = frame
            }
            if new_bpm > 0.0 {
              bpm = new_bpm
            }
          },
          RenderTo(target) => {
            // Two bare ifs rather than if/else: a trailing if/else in a
            // block is parsed as an if *expression* and must yield a value.
            if target <= frame {
              // No-op render: stop right here and report the current frame.
              if playing {
                paused_tick = playhead_at(span_start_tick, span_start_frame, frame, ticks_per_frame(bpm))
                playing = false
              }
              let _sil = voices_silence_all(&mut vi, &mut vf)
              render_active = false
              pending_stopped = true
              stopped_frame = frame
            }
            if target > frame {
              render_target = target
              render_active = true
              if playing == false {
                span_start_tick = paused_tick
                span_start_frame = frame
                playing = true
                last_bar = floor(paused_tick / bar_ticks() as f64)
              }
            }
          },
          PatternBegin(h) => {
            // Clears ONLY staging; a committed pending buffer survives
            // until its swap boundary (ADR §4).
            stg_notes = Vec::new()
            stg_tracks = Vec::new()
            stg_len = h.length_ticks
          },
          PatternNote(n) => {
            stg_notes.push(n)
          },
          PatternTrack(tp) => {
            stg_tracks.push(tp)
          },
          PatternCommit => {
            pnd_notes = Vec::new()
            let _cn = copy_notes(&stg_notes, &mut pnd_notes)
            let _sn = sort_notes_by_tick(&mut pnd_notes)
            pnd_tracks = Vec::new()
            let _ct = copy_tracks(&stg_tracks, &mut pnd_tracks)
            pnd_len = stg_len
            pending_valid = true
            // "Immediately when stopped" is decided HERE, at apply time,
            // not after the drain: a Play or RenderTo later in the same
            // drain pass would otherwise make this look like a commit
            // during playback and defer it to the next bar line, which
            // silently swallows the very first pattern of a render.
            if playing == false {
              commit_while_stopped = true
            }
          },
          NoteOn(nc) => {
            // Live notes are block-quantized: applying during the drain
            // lands them at frame 0 of the block about to be rendered.
            // They sound whether or not the transport is running --
            // auditioning while stopped is intended MCP behaviour.
            let tp = track_params_for(&act_tracks, nc.track)
            let g: f64 = effective_gain(&gain_ovr, nc.track, tp.gain)
            let _on = voices_note_on(&mut vi, &mut vf, &mut vt, frame, nc.track, nc.pitch, nc.velocity, tp.waveform, g, tp.attack_ms, tp.decay_ms, tp.sustain, tp.release_ms)
          },
          NoteOff(nc2) => {
            let _off = voices_note_off(&mut vi, &mut vf, nc2.track, nc2.pitch)
          },
          SetTrackGain(gc) => {
            if gc.track < max_tracks() {
              gain_ovr[gc.track as usize] = gc.gain
            }
            // Also retune voices already sounding on that track, so a
            // live "turn track 2 down" is audible immediately.
            let _sg = voices_set_track_gain(&mut vi, &mut vf, gc.track, gc.gain)
          },
          Shutdown => {
            running = false
            draining = false
          },
        },
        Empty => { draining = false },
        // Control is gone: same finalize path as Shutdown (ADR §5).
        Disconnected => {
          running = false
          draining = false
        },
      }
    }

    if running {
      // ---- pattern swap boundary (ADR §6) ----
      // Immediately when stopped; at the next bar line while playing.
      let tpf: f64 = ticks_per_frame(bpm)
      let head: f64 = if playing { playhead_at(span_start_tick, span_start_frame, frame, tpf) } else { paused_tick }
      let bar_now: f64 = floor(head / bar_ticks() as f64)
      let mut swap: bool = false
      if pending_valid {
        if commit_while_stopped || playing == false {
          swap = true
        }
        if playing && bar_now != last_bar {
          swap = true
        }
      }
      last_bar = bar_now
      if swap {
        // Notes still sounding from the outgoing pattern would never get
        // their note_off -- those events are generated from the ACTIVE
        // note list, which is about to be replaced -- so they would ring
        // forever. Release them on their own release ramps, which is also
        // what keeps the swap click-free.
        if playing {
          let _rel = voices_release_all(&mut vi, &mut vf)
        }
        act_notes = Vec::new()
        let _an = copy_notes(&pnd_notes, &mut act_notes)
        act_tracks = Vec::new()
        let _at = copy_tracks(&pnd_tracks, &mut act_tracks)
        act_len = pnd_len
        pending_valid = false
        commit_while_stopped = false
      }

      // ---- how many frames this block ----
      // A RenderTo target is landed on EXACTLY, with a short final block
      // if needed, so the offline WAV length is byte-reproducible.
      let mut frames: u32 = block_frames()
      if render_active {
        let remaining: u64 = render_target - frame
        if remaining < frames as u64 {
          frames = remaining as u32
        }
      }

      // Offline and idle: nothing to render and no device to feed, so
      // don't write silence into the WAV. Live always renders, because
      // the device must stay fed.
      let active_voices: i32 = voices_active_count(&vi)
      let must_render: bool = playing || active_voices > 0 || sink_kind == sink_live()

      if must_render == false || frames == 0 {
        let _slept = sleep_ms(1)
      } else {
        // ---- schedule this block's note edges (GLYPH-58) ----
        let block_start_tick: f64 = head
        let block_end_tick: f64 = head + frames as f64 * tpf
        let mut evs: Vec<SchedEvent> = Vec::new()
        if playing && act_len > 0 {
          let _ce = collect_events(&act_notes, act_len, block_start_tick, block_end_tick, tpf, frames, &mut evs)
          let _se = sort_events(&mut evs)
        }

        // ---- render, splitting the block at each event ----
        let mut block: Vec<f64> = Vec::new()
        let mut cursor: u32 = 0
        let mut ei: i32 = 0
        while ei < evs.len() as i32 {
          let ev = evs[ei as usize]
          if ev.frame_offset > cursor {
            let seg: Vec<f64> = voices_render_block(&mut vi, &mut vf, ev.frame_offset - cursor)
            let _ap = append_samples(&mut block, &seg)
            cursor = ev.frame_offset
          }
          if ev.kind == 1 {
            let tp2 = track_params_for(&act_tracks, ev.track)
            let g2: f64 = effective_gain(&gain_ovr, ev.track, tp2.gain)
            let _on2 = voices_note_on(&mut vi, &mut vf, &mut vt, frame + cursor as u64, ev.track, ev.pitch, ev.velocity, tp2.waveform, g2, tp2.attack_ms, tp2.decay_ms, tp2.sustain, tp2.release_ms)
          } else {
            let _off2 = voices_note_off(&mut vi, &mut vf, ev.track, ev.pitch)
          }
          ei = ei + 1
        }
        if cursor < frames {
          let seg2: Vec<f64> = voices_render_block(&mut vi, &mut vf, frames - cursor)
          let _ap2 = append_samples(&mut block, &seg2)
        }

        // ---- hand the block to the sink ----
        let wrc = sink_write(sink_kind, handle, &block)
        if wrc != 0 {
          status = 91
          running = false
        }

        let peak: f64 = block_peak(&block)
        frame = frame + frames as u64

        // ---- telemetry: lossy, never blocks, never retries (ADR §5) ----
        if dropped > 0 {
          let ov = t.try_send(EngineReport::Overflow(dropped))
          match ov {
            Sent => { dropped = 0 },
            Full(_o) => {},
            Disconnected(_o2) => { running = false },
          }
        }
        let head_after: f64 = if playing { playhead_at(span_start_tick, span_start_frame, frame, tpf) } else { paused_tick }
        let pr = t.try_send(EngineReport::Position(PositionReport {
          frame: frame,
          tick: local_tick(head_after, act_len),
          playing: playing,
        }))
        match pr {
          Sent => {},
          Full(_p) => { dropped = dropped + 1 },
          Disconnected(_p2) => { running = false },
        }
        let br = t.try_send(EngineReport::BlockRendered(BlockReport { frame: frame, peak: peak }))
        match br {
          Sent => {},
          Full(_b) => { dropped = dropped + 1 },
          Disconnected(_b2) => { running = false },
        }

        // ---- RenderTo target reached: hard stop, exact length ----
        if render_active && frame >= render_target {
          paused_tick = playhead_at(span_start_tick, span_start_frame, frame, tpf)
          playing = false
          // Hard silence rather than a 5 ms choke: the caller asked for
          // exactly N frames, so nothing may be rendered past N.
          let _sil2 = voices_silence_all(&mut vi, &mut vf)
          render_active = false
          pending_stopped = true
          stopped_frame = frame
        }
      }

      // Stopped is important enough to retry (bounded), unlike the rest of
      // the telemetry.
      if pending_stopped {
        let mut tries: i32 = 0
        let mut sent: bool = false
        while sent == false && tries < 100 {
          let sp = t.try_send(EngineReport::Stopped(stopped_frame))
          match sp {
            Sent => { sent = true },
            Full(_s) => {
              let _sl = sleep_ms(1)
            },
            Disconnected(_s2) => {
              sent = true
              running = false
            },
          }
          tries = tries + 1
        }
        pending_stopped = false
      }
    }
  }

  // ---- finalize (ADR §9) ----
  let _rel = voices_silence_all(&mut vi, &mut vf)
  let crc = sink_close(sink_kind, handle)
  if crc != 0 && status == 0 {
    status = 92
  }

  let mut tries2: i32 = 0
  let mut sent2: bool = false
  while sent2 == false && tries2 < 100 {
    let fin = t.try_send(EngineReport::Stopped(frame))
    match fin {
      Sent => { sent2 = true },
      Full(_f3) => {
        let _sl2 = sleep_ms(1)
      },
      // Control is gone; the join result is the ground truth for it.
      Disconnected(_f4) => { sent2 = true },
    }
    tries2 = tries2 + 1
  }

  ret status
}
