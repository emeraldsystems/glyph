// GLYPH-55 -- control-thread data model. Single-threaded only; never
// crosses threads (see SEQUENCER_CORE.md §3). v1 flattens the ADR §10
// preview to one pattern per song.
//
// Known compiler-current limitation: std/string's string_from_f64 formats
// with C's "%.17g" (see runtime/glyph_json.c), not a shortest-round-trip
// decimal form. So a value like 0.8 serializes as
// "0.80000000000000004" instead of "0.8" -- correct (it re-parses to the
// exact same f64 and JSON round-trips are byte-identical across repeated
// serializations), just not visually minimal. std/math's shortest-round-trip
// formatter (used by print/println interpolation) is not exposed as a
// String-returning function, so it isn't available here. Key order and
// structure follow the canonical schema in SEQUENCER_CORE.md §10 exactly;
// only float rendering width differs from the doc's illustrative numbers.

from std/enums import Result, Option
from std/json import JsonValue, ParseResult
from std/json/parser import parse, json_get_object, json_get_array, json_get_number
from std/map import Map
from std/math import pow
from std/string import string_from_i32, string_from_f64
from std/vec import Vec

enum Waveform { SineWave, SawWave, SquareWave, TriangleWave }

fn waveform_code(w: Waveform) -> u32 {
  ret match w {
    SineWave => 0,
    SawWave => 1,
    SquareWave => 2,
    TriangleWave => 3,
  }
}

fn waveform_from_code(code: u32) -> Waveform {
  if code == 1 { ret Waveform::SawWave }
  if code == 2 { ret Waveform::SquareWave }
  if code == 3 { ret Waveform::TriangleWave }
  ret Waveform::SineWave
}

struct AdsrParams {
  attack_ms: f64,
  decay_ms: f64,
  sustain: f64,
  release_ms: f64,
}

struct NoteEvent {
  track: u32,
  tick: u32,
  length_ticks: u32,
  pitch: u32,
  velocity: f64,
}

// Flat -- matches wire TrackParamsMsg (SEQUENCER_CORE.md §4).
struct TrackParams {
  track: u32,
  waveform: u32,
  gain: f64,
  attack_ms: f64,
  decay_ms: f64,
  sustain: f64,
  release_ms: f64,
}

// ok: 1 = parse success, 0 = failure.
struct SongMeta {
  ok: u32,
  bpm: f64,
  ppq: u32,
  length_ticks: u32,
}

// pitch is cast to f64 BEFORE the subtraction: pitch is unsigned and
// pitch - 69 underflows for the whole register below A4 (ADR §8).
fn midi_to_freq(pitch: u32) -> f64 {
  ret 440.0 * pow(2.0, (pitch as f64 - 69.0) / 12.0)
}

// --- JSON serialization ---
// Canonical key order (SEQUENCER_CORE.md §10):
// {"bpm":..,"ppq":..,"length_ticks":..,"tracks":[...],"notes":[...]}
// track: {"track":..,"waveform":..,"gain":..,"attack_ms":..,"decay_ms":..,
//         "sustain":..,"release_ms":..}
// note:  {"track":..,"tick":..,"length_ticks":..,"pitch":..,"velocity":..}

fn track_to_json(t: TrackParams) -> String {
  let mut out = String::from_str("{\"track\":")
  out = out.concat(string_from_i32(t.track as i32))
  out = out.concat(String::from_str(",\"waveform\":"))
  out = out.concat(string_from_i32(t.waveform as i32))
  out = out.concat(String::from_str(",\"gain\":"))
  out = out.concat(string_from_f64(t.gain))
  out = out.concat(String::from_str(",\"attack_ms\":"))
  out = out.concat(string_from_f64(t.attack_ms))
  out = out.concat(String::from_str(",\"decay_ms\":"))
  out = out.concat(string_from_f64(t.decay_ms))
  out = out.concat(String::from_str(",\"sustain\":"))
  out = out.concat(string_from_f64(t.sustain))
  out = out.concat(String::from_str(",\"release_ms\":"))
  out = out.concat(string_from_f64(t.release_ms))
  out = out.concat(String::from_str("}"))
  ret out
}

fn note_to_json(n: NoteEvent) -> String {
  let mut out = String::from_str("{\"track\":")
  out = out.concat(string_from_i32(n.track as i32))
  out = out.concat(String::from_str(",\"tick\":"))
  out = out.concat(string_from_i32(n.tick as i32))
  out = out.concat(String::from_str(",\"length_ticks\":"))
  out = out.concat(string_from_i32(n.length_ticks as i32))
  out = out.concat(String::from_str(",\"pitch\":"))
  out = out.concat(string_from_i32(n.pitch as i32))
  out = out.concat(String::from_str(",\"velocity\":"))
  out = out.concat(string_from_f64(n.velocity))
  out = out.concat(String::from_str("}"))
  ret out
}

fn tracks_to_json(tracks: &Vec<TrackParams>) -> String {
  let mut out = String::from_str("[")
  let mut i: i32 = 0
  while i < tracks.len() as i32 {
    if i > 0 { out = out.concat(String::from_str(",")) }
    out = out.concat(track_to_json(tracks[i as usize]))
    i = i + 1
  }
  out = out.concat(String::from_str("]"))
  ret out
}

fn notes_to_json(notes: &Vec<NoteEvent>) -> String {
  let mut out = String::from_str("[")
  let mut i: i32 = 0
  while i < notes.len() as i32 {
    if i > 0 { out = out.concat(String::from_str(",")) }
    out = out.concat(note_to_json(notes[i as usize]))
    i = i + 1
  }
  out = out.concat(String::from_str("]"))
  ret out
}

fn song_to_json(bpm: f64, ppq: u32, length_ticks: u32, tracks: &Vec<TrackParams>, notes: &Vec<NoteEvent>) -> String {
  let mut out = String::from_str("{\"bpm\":")
  out = out.concat(string_from_f64(bpm))
  out = out.concat(String::from_str(",\"ppq\":"))
  out = out.concat(string_from_i32(ppq as i32))
  out = out.concat(String::from_str(",\"length_ticks\":"))
  out = out.concat(string_from_i32(length_ticks as i32))
  out = out.concat(String::from_str(",\"tracks\":"))
  out = out.concat(tracks_to_json(tracks))
  out = out.concat(String::from_str(",\"notes\":"))
  out = out.concat(notes_to_json(notes))
  out = out.concat(String::from_str("}"))
  ret out
}

// --- JSON parsing ---
// Any missing or malformed field -- including a wrong-typed value like
// {"bpm":"x"} -- fails the whole parse (SongMeta.ok = 0) BEFORE anything
// is pushed into the caller's out-Vecs, so a failed parse always leaves
// them at their original length.

fn get_num(obj: &Map<String, JsonValue>, key: str) -> Option<f64> {
  let got = obj.get(String::from_str(key))
  ret match got {
    Some(v) => json_get_number(v),
    None => None,
  }
}

fn get_arr(obj: &Map<String, JsonValue>, key: str) -> Option<Vec<JsonValue>> {
  let got = obj.get(String::from_str(key))
  ret match got {
    Some(v) => json_get_array(v),
    None => None,
  }
}

fn track_from_object(obj: &Map<String, JsonValue>) -> Option<TrackParams> {
  let track_n = match get_num(obj, "track") { Some(v) => v, None => { ret None } }
  let waveform_n = match get_num(obj, "waveform") { Some(v) => v, None => { ret None } }
  let gain = match get_num(obj, "gain") { Some(v) => v, None => { ret None } }
  let attack_ms = match get_num(obj, "attack_ms") { Some(v) => v, None => { ret None } }
  let decay_ms = match get_num(obj, "decay_ms") { Some(v) => v, None => { ret None } }
  let sustain = match get_num(obj, "sustain") { Some(v) => v, None => { ret None } }
  let release_ms = match get_num(obj, "release_ms") { Some(v) => v, None => { ret None } }
  ret Some(TrackParams {
    track: track_n as u32,
    waveform: waveform_n as u32,
    gain: gain,
    attack_ms: attack_ms,
    decay_ms: decay_ms,
    sustain: sustain,
    release_ms: release_ms,
  })
}

// Routed through a helper with a typed JsonValue param (SEQUENCER_CORE.md
// §3 constraint #5 / nested payload-of-payload idiom): inlining a match on
// `v` directly inside the `Some(v) => ...` arm above loses v's type.
fn track_from_value(v: JsonValue) -> Option<TrackParams> {
  let obj_opt = json_get_object(v)
  ret match obj_opt {
    Some(obj) => track_from_object(&obj),
    None => None,
  }
}

fn note_from_object(obj: &Map<String, JsonValue>) -> Option<NoteEvent> {
  let track_n = match get_num(obj, "track") { Some(v) => v, None => { ret None } }
  let tick_n = match get_num(obj, "tick") { Some(v) => v, None => { ret None } }
  let length_n = match get_num(obj, "length_ticks") { Some(v) => v, None => { ret None } }
  let pitch_n = match get_num(obj, "pitch") { Some(v) => v, None => { ret None } }
  let velocity = match get_num(obj, "velocity") { Some(v) => v, None => { ret None } }
  ret Some(NoteEvent {
    track: track_n as u32,
    tick: tick_n as u32,
    length_ticks: length_n as u32,
    pitch: pitch_n as u32,
    velocity: velocity,
  })
}

fn note_from_value(v: JsonValue) -> Option<NoteEvent> {
  let obj_opt = json_get_object(v)
  ret match obj_opt {
    Some(obj) => note_from_object(&obj),
    None => None,
  }
}

fn fail_meta() -> SongMeta {
  ret SongMeta { ok: 0, bpm: 0.0, ppq: 0, length_ticks: 0 }
}

fn song_from_object(obj: &Map<String, JsonValue>, tracks: &mut Vec<TrackParams>, notes: &mut Vec<NoteEvent>) -> SongMeta {
  let bpm = match get_num(obj, "bpm") { Some(v) => v, None => { ret fail_meta() } }
  let ppq_n = match get_num(obj, "ppq") { Some(v) => v, None => { ret fail_meta() } }
  let length_n = match get_num(obj, "length_ticks") { Some(v) => v, None => { ret fail_meta() } }
  let mut tracks_arr = match get_arr(obj, "tracks") { Some(v) => v, None => { ret fail_meta() } }
  let mut notes_arr = match get_arr(obj, "notes") { Some(v) => v, None => { ret fail_meta() } }

  // Parse into locals first; only copy into the caller's out-Vecs once the
  // whole document has validated, so a mid-array failure leaves the
  // caller's Vecs untouched.
  let mut parsed_tracks: Vec<TrackParams> = Vec::new()
  let mut i: i32 = 0
  while i < tracks_arr.len() as i32 {
    let t_opt = track_from_value(tracks_arr[i as usize])
    match t_opt {
      Some(t) => { parsed_tracks.push(t) },
      None => { ret fail_meta() },
    }
    i = i + 1
  }

  let mut parsed_notes: Vec<NoteEvent> = Vec::new()
  let mut j: i32 = 0
  while j < notes_arr.len() as i32 {
    let n_opt = note_from_value(notes_arr[j as usize])
    match n_opt {
      Some(n) => { parsed_notes.push(n) },
      None => { ret fail_meta() },
    }
    j = j + 1
  }

  let mut ti: i32 = 0
  while ti < parsed_tracks.len() as i32 {
    tracks.push(parsed_tracks[ti as usize])
    ti = ti + 1
  }
  let mut ni: i32 = 0
  while ni < parsed_notes.len() as i32 {
    notes.push(parsed_notes[ni as usize])
    ni = ni + 1
  }

  ret SongMeta { ok: 1, bpm: bpm, ppq: ppq_n as u32, length_ticks: length_n as u32 }
}

fn song_from_json(text: str, tracks: &mut Vec<TrackParams>, notes: &mut Vec<NoteEvent>) -> SongMeta {
  let parsed = parse(text)
  ret match parsed {
    Ok(v) => {
      let obj_opt = json_get_object(v)
      match obj_opt {
        Some(obj) => song_from_object(&obj, tracks, notes),
        None => fail_meta(),
      }
    },
    Err(_e) => fail_meta(),
  }
}
